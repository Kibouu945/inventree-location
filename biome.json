{
  "$schema": "https://biomejs.dev",
  "files": {
    "includes": [
      "**",
      "frontend/src/**",
      "!frontend/src/locales",
      "!**/inventree_location/static",
      "!**/dist",
      "!**/node_modules"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      }
    }
  },
  "formatter": {
    "enabled": true
  }
}
